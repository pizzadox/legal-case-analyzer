// Criminal Case Management System - Database Schema (for doc-processor mini-service)
// Points to the same database as the main project

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:/home/z/my-project/db/custom.db"
}

// Criminal Case model - represents a single criminal case
model CriminalCase {
  id                String   @id @default(cuid())
  caseNumber        String
  caseTitle         String
  defendantName     String?
  articles          String?
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  documents         Document[]
  persons           Person[]
  episodes          Episode[]
}

// Core document model
model Document {
  id                String   @id @default(cuid())
  fileName          String
  originalName      String
  filePath          String
  fileSize          Int
  mimeType          String
  extractedText     String?
  summary           String?
  documentDate      String?
  documentType      String?
  sourceReference   String?
  processingStatus  String   @default("pending")
  processingError   String?
  uploadedAt        DateTime @default(now())
  processedAt       DateTime?
  caseId            String?

  // Relations
  case              CriminalCase? @relation(fields: [caseId], references: [id])
  persons           PersonDocument[]
  episodes          EpisodeDocument[]
  locations         DocumentLocation[]
  articles          DocumentArticle[]
  crossReferences   CrossReference[]  @relation("SourceDoc")
  referencedBy      CrossReference[]  @relation("TargetDoc")
  complianceChecks  LegalCompliance[]
  chatReferences    ChatMessageDocument[]
  processingQueue   ProcessingQueue[]
}

// Person/participant in the case
model Person {
  id                String   @id @default(cuid())
  fullName          String
  shortName         String?
  role              String?
  status            String?
  description       String?
  birthDate         String?
  occupation        String?
  alias             String?
  isKolesnichenko   Boolean  @default(false)
  defenseStrategy   String?
  caseId            String?

  // Relations
  case              CriminalCase? @relation(fields: [caseId], references: [id])
  documents         PersonDocument[]
  episodes          PersonEpisode[]
  articles          PersonArticle[]
  defenseLines      DefenseLine[]
  guiltAssessments  GuiltAssessment[]
  chatReferences    ChatMessagePerson[]
}

// Location/place mentioned in case
model Location {
  id                String   @id @default(cuid())
  name              String
  address           String?
  type              String?
  description       String?
  coordinates       String?

  // Relations
  documents         DocumentLocation[]
  episodes          EpisodeLocation[]
}

// Article of law referenced in case
model Article {
  id                String   @id @default(cuid())
  code              String
  number            String
  codeType          String   @default("УК РФ")
  description       String
  category          String?
  punishmentMin     String?
  punishmentMax     String?
  isCurrent         Boolean  @default(true)

  // Relations
  documents         DocumentArticle[]
  persons           PersonArticle[]
  episodes          EpisodeArticle[]
  complianceChecks  LegalCompliance[]
}

// Episode/incident in the case
model Episode {
  id                String   @id @default(cuid())
  title             String
  description       String
  date              String?
  episodeNumber     String?
  severity          String?
  status            String?
  caseId            String?

  // Relations
  case              CriminalCase? @relation(fields: [caseId], references: [id])
  documents         EpisodeDocument[]
  persons           PersonEpisode[]
  locations         EpisodeLocation[]
  articles          EpisodeArticle[]
  guiltAssessments  GuiltAssessment[]
}

// Cross-reference between documents
model CrossReference {
  id                String   @id @default(cuid())
  sourceDocumentId  String
  targetDocumentId  String
  referenceText     String
  referenceType     String?
  context           String?
  note              String?

  sourceDocument    Document @relation("SourceDoc", fields: [sourceDocumentId], references: [id])
  targetDocument    Document @relation("TargetDoc", fields: [targetDocumentId], references: [id])
}

// Processing queue for batch file uploads
model ProcessingQueue {
  id                String   @id @default(cuid())
  documentId        String
  queuePosition     Int
  status            String   @default("queued")
  startedAt         DateTime?
  completedAt       DateTime?
  error             String?
  priority          Int      @default(5)
  progressPercent   Int      @default(0)
  progressStep      String?

  document          Document @relation(fields: [documentId], references: [id])
}

// Legal compliance check results
model LegalCompliance {
  id                String   @id @default(cuid())
  documentId        String
  articleId         String?
  checkType         String
  status            String
  description       String
  recommendation    String?
  legalBasis        String?
  checkedAt         DateTime @default(now())

  document          Document @relation(fields: [documentId], references: [id])
  article           Article? @relation(fields: [articleId], references: [id])
}

// Defense line for Kolesnichenko
model DefenseLine {
  id                String   @id @default(cuid())
  personId          String
  strategyType      String
  title             String
  description       String
  evidence          String?
  strength          String?
  probability       String?
  articleReferences String?

  person            Person   @relation(fields: [personId], references: [id])
}

// Guilt assessment with forecasts
model GuiltAssessment {
  id                String   @id @default(cuid())
  personId          String
  episodeId         String?
  guiltLevel        String
  evidenceStrength  String
  forecast          String?
  confidence        String?
  mitigating        String?
  aggravating       String?
  analysisDate      DateTime @default(now())
  notes             String?

  person            Person   @relation(fields: [personId], references: [id])
  episode           Episode? @relation(fields: [episodeId], references: [id])
}

// Chat messages for AI Q&A
model ChatMessage {
  id                String   @id @default(cuid())
  question          String
  answer            String
  contextType       String?
  contextId         String?
  createdAt         DateTime @default(now())

  // Relations
  documents         ChatMessageDocument[]
  persons           ChatMessagePerson[]
}

// Junction tables
model PersonDocument {
  id                String   @id @default(cuid())
  personId          String
  documentId        String
  role              String?
  context           String?

  person            Person   @relation(fields: [personId], references: [id])
  document          Document @relation(fields: [documentId], references: [id])
}

model EpisodeDocument {
  id                String   @id @default(cuid())
  episodeId         String
  documentId        String
  relevance         String?

  episode           Episode  @relation(fields: [episodeId], references: [id])
  document          Document @relation(fields: [documentId], references: [id])
}

model DocumentLocation {
  id                String   @id @default(cuid())
  documentId        String
  locationId        String
  context           String?

  document          Document @relation(fields: [documentId], references: [id])
  location          Location @relation(fields: [locationId], references: [id])
}

model DocumentArticle {
  id                String   @id @default(cuid())
  documentId        String
  articleId         String
  context           String?

  document          Document @relation(fields: [documentId], references: [id])
  article           Article  @relation(fields: [articleId], references: [id])
}

model PersonEpisode {
  id                String   @id @default(cuid())
  personId          String
  episodeId         String
  involvement       String?

  person            Person   @relation(fields: [personId], references: [id])
  episode           Episode  @relation(fields: [episodeId], references: [id])
}

model PersonArticle {
  id                String   @id @default(cuid())
  personId          String
  articleId         String
  chargeStatus      String?

  person            Person   @relation(fields: [personId], references: [id])
  article           Article  @relation(fields: [articleId], references: [id])
}

model EpisodeLocation {
  id                String   @id @default(cuid())
  episodeId         String
  locationId        String
  context           String?

  episode           Episode  @relation(fields: [episodeId], references: [id])
  location          Location @relation(fields: [locationId], references: [id])
}

model EpisodeArticle {
  id                String   @id @default(cuid())
  episodeId         String
  articleId         String

  episode           Episode  @relation(fields: [episodeId], references: [id])
  article           Article  @relation(fields: [articleId], references: [id])
}

model ChatMessageDocument {
  id                String   @id @default(cuid())
  chatMessageId     String
  documentId        String

  chatMessage       ChatMessage @relation(fields: [chatMessageId], references: [id])
  document          Document    @relation(fields: [documentId], references: [id])
}

model ChatMessagePerson {
  id                String   @id @default(cuid())
  chatMessageId     String
  personId          String

  chatMessage       ChatMessage @relation(fields: [chatMessageId], references: [id])
  person            Person      @relation(fields: [personId], references: [id])
}
