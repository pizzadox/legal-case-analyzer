# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Database files with user data
/db/*.db
/db/*.db-journal

# Uploaded files (large, user data)
/upload/

# Build artifacts
/.next/standalone/
/.next/static/

# Mini service logs
mini-services/*/processor.log
mini-services/*/*.log

# Bun lockfiles
bun.lock

# Caddy config is project-specific, keep it
!Caddyfile

# Keep-alive scripts
mini-services/*/keep-alive.sh
mini-services/*/start-daemon.sh

# Tool results (temporary)
/tool-results/

# Screenshots (temporary)
screenshot*.png
qa-verify*.png

# Shell scripts (project-specific)
start.sh
start-server.sh
server-start.sh
keep-server-alive.sh
doc-processor-start.sh

# Worklog (project-specific runtime)
worklog.md

# Large files
*.pdf
*.png
